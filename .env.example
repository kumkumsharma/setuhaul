# SetuHaul Logistics — Environment Example
# Copy to .env and fill in values. Never commit .env.

# Database (SQLite by default for local MVP)
DATABASE_URL=sqlite:///./data/runtime/setuhaul.db

# Redis
# Use "fakeredis://" for in-process Redis (no Docker needed)
# Use "redis://localhost:6379/0" for a real Redis instance
REDIS_URL=fakeredis://

# Hold TTL in seconds (short exclusive claim on a slot)
HOLD_TTL_SECONDS=120

# Idempotency key TTL
IDEMPOTENCY_TTL_SECONDS=600

# Scenario "now" used for feasibility (ISO-8601). Leave empty to use wall clock.
# Matches PDF Jaipur evening contention snapshot.
SCENARIO_NOW=2026-08-11T17:25:00+05:30

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
