# SetuHaul Logistics — Environment Example
# Copy to .env and fill in values. Never commit .env.

# Database
# Local default: sqlite:///./data/runtime/setuhaul.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./data/runtime/setuhaul.db

# Redis
# Use "fakeredis://" for in-process Redis (no Docker needed)
# Use "redis://localhost:6379/0" for a real Redis instance
REDIS_URL=fakeredis://

# Hold TTL in seconds (short exclusive claim on a slot)
HOLD_TTL_SECONDS=120

# Idempotency key TTL
IDEMPOTENCY_TTL_SECONDS=600

# Scenario "now" used for feasibility (ISO-8601). Leave empty to use wall clock.
# Matches PDF Jaipur evening contention snapshot.
SCENARIO_NOW=2026-08-11T17:25:00+05:30

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Phase 2 — Geoapify (optional; mock used when key empty or GEOAPIFY_MOCK=true)
GEOAPIFY_API_KEY=
GEOAPIFY_MOCK=true
LOCATION_STALE_MINUTES=30
TRUCK_SPEED_KMH=45

# Phase 2 — optional LangSmith tracing (leave empty / false to disable)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=setuhaul-fde
# Set true with a real LANGSMITH_API_KEY to emit LangChain traces for agent runs
LANGSMITH_TRACING=false
# Optional labels attached to LangSmith root metadata/tags (local defaults are fine)
APP_ENV=local
# Set at build/deploy time if available (leave empty locally)
GIT_SHA=

# Phase 3 — conversational agent via OpenRouter (optional; rules fallback if unset)
# Prefer openai/gpt-4o-mini for reliable tool calling. Avoid Gemini 3.x on OpenRouter
# (thought_signature stripping breaks multi-turn tools).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Legacy direct Gemini (used only when OPENROUTER_API_KEY is unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

